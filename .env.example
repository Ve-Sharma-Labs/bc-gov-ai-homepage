APP_ENV=development
WEB_PORT=3000
API_PORT=8000

# Copy this file to the ignored repository-root .env, then use npm run dev.
# APP_ENV=development uses the existing Azure CLI login; verify az account show.
# Leave these unset for honestly labelled, source-backed guided plans.
# No model calls are fabricated when Foundry is not connected.
FOUNDRY_PROJECT_ENDPOINT=
# Paste the complete seven-binding JSON array emitted by the approved publisher.
# In .env, wrap the JSON in single quotes to retain its double-quoted keys.
FOUNDRY_AGENTS=[]
# Separate pinned general-chat binding: name, version and modelDeployment.
# Leave unset until that managed agent has actually been published and verified.
FOUNDRY_GENERAL_AGENT=
# Separate pinned contextual-demo binding. Export with publish_agents --contextual-only;
# leave unset until the reviewed version is explicitly published.
FOUNDRY_CONTEXTUAL_AGENT=
# Development only; production uses managed identity, not the Azure CLI.
AZURE_CLI_PROCESS_TIMEOUT_SECONDS=15
# Legacy single-agent connection is development-only.
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
AZURE_CLIENT_ID=
AZURE_SEARCH_ENDPOINT=
# The index must already contain genuinely published, approved documents.
# A created Search service or published agents alone do not enable sourced chat.
AZURE_SEARCH_INDEX=
# The future v2 cutover must set the exact v2 index, metadata mode and reviewed
# schema flag together in one API revision.
AZURE_SEARCH_METADATA_ENABLED=false
AZURE_SEARCH_METADATA_REVIEWED=0

# These are separately reviewed capabilities, not pilot defaults.
WEBIQ_ENABLED=false
SYNTHETIC_CONTEXT_ENABLED=false
AZURE_SYNTHETIC_CONTEXT_APPROVED=0
SYNTHETIC_CONTEXT_SESSION_TTL_SECONDS=1800
SYNTHETIC_CONTEXT_CONSENT_TTL_SECONDS=900
SYNTHETIC_CONTEXT_AUDIT_MAX_EVENTS=100
SYNTHETIC_CONTEXT_AUDIT_MAX_BYTES=65536
APPLICATIONINSIGHTS_CONNECTION_STRING=
API_METRICS_ENABLED=false

# Public Azure deployments inject these server-only settings from reviewed IaC.
REDIS_ENDPOINT=
REDIS_CLIENT_ID=
API_AUTH_TENANT_ID=
API_AUTH_AUDIENCE=
API_AUTH_CALLERS=[]
API_DAILY_RUN_LIMIT=0
API_DAILY_TOKEN_LIMIT=0
API_DAILY_COST_LIMIT_MICROUSD=0
API_TOKEN_PRICE_MICROUSD=0
# Web service only: API_AUTH_SCOPE, FRONT_DOOR_ID and CLIENT_HASH_KEY.
# Never put CLIENT_HASH_KEY in source control; IaC generates a Container App secret.

# Never commit credentials or expose them through NEXT_PUBLIC_* variables.
# API_BASE_URL and CONTENT_CATALOG_PATH are set by npm run dev.
