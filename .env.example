APP_ENV=development
WEB_PORT=3000
API_PORT=8000

# Copy this file to the ignored repository-root .env, then use npm run dev.
# APP_ENV=development uses the existing Azure CLI login; verify az account show.
# Leave these unset for honestly labelled, source-backed guided plans.
# No model calls are fabricated when Foundry is not connected.
FOUNDRY_PROJECT_ENDPOINT=
# Paste the complete seven-binding JSON array emitted by the approved publisher.
# In .env, wrap the JSON in single quotes to retain its double-quoted keys.
FOUNDRY_AGENTS=[]
# Separate pinned general-chat binding: name, version and modelDeployment.
# Leave unset until that managed agent has actually been published and verified.
FOUNDRY_GENERAL_AGENT=
# Separate pinned contextual-demo binding. Export with publish_agents --contextual-only;
# leave unset until the reviewed version is explicitly published.
FOUNDRY_CONTEXTUAL_AGENT=
# Development only; production uses managed identity, not the Azure CLI.
AZURE_CLI_PROCESS_TIMEOUT_SECONDS=15
# Optional local pin; does not change the CLI's global default or production managed identity.
AZURE_CLI_SUBSCRIPTION=
# Legacy single-agent connection is development-only.
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
AZURE_CLIENT_ID=
AZURE_SEARCH_ENDPOINT=
# The index must already contain genuinely published, approved documents.
# A created Search service or published agents alone do not enable sourced chat.
AZURE_SEARCH_INDEX=
# The future v2 cutover must set the exact v2 index, metadata mode and reviewed
# schema flag together in one API revision.
AZURE_SEARCH_METADATA_ENABLED=false
AZURE_SEARCH_METADATA_REVIEWED=0
# An isolated metadata-aware target may be named explicitly after schema review.
# Never use the live legacy bc-pilot-public index as an experiment target.
AZURE_SEARCH_METADATA_INDEX=bc-pilot-public-v2

# These are separately reviewed capabilities, not pilot defaults.
WEBIQ_ENABLED=false
SYNTHETIC_CONTEXT_ENABLED=false
CONVERSATION_DISCOVERY_ENABLED=false
AI_CONVERSATION_ENABLED=false
TASK_ASSISTANCE_ENABLED=false
AI_CONVERSATION_PRIVACY_REVIEWED=false
# Separate, reviewed conversation planner. Publish an isolated definition before setting this.
FOUNDRY_CONVERSATION_AGENT=
# Version 6 is an opt-in candidate, not an activation of the source blueprints.
# Public activation requires source rights, content review, evaluation and privacy gates.
GROUNDED_CONVERSATION_ENABLED=false
GROUNDED_CONVERSATION_PRIVACY_REVIEWED=false
FOUNDRY_GROUNDED_CONVERSATION_AGENT=
FOUNDRY_GROUNDED_ANSWER_AGENT=
# Optional loopback-only, non-commercial evaluation profile; never enable in production.
# Requires APP_ENV=development, v6, and exclusively loopback API hosts/origins.
LOCAL_EVIDENCE_EVALUATION_ENABLED=false
# Optional absolute path and SHA-256 pin for dated, permitted Canada.ca source copies.
# Keep both empty when the local profile is off. Do not commit copied source material.
LOCAL_EVIDENCE_SNAPSHOT_PATH=
LOCAL_EVIDENCE_SNAPSHOT_SHA256=
# Public activation requires a recorded review of purpose, processing, and retention.
CONVERSATION_DISCOVERY_PRIVACY_REVIEWED=false
CONVERSATION_CONTEXT_TTL_SECONDS=1800
AZURE_SYNTHETIC_CONTEXT_APPROVED=0
SYNTHETIC_CONTEXT_SESSION_TTL_SECONDS=1800
SYNTHETIC_CONTEXT_CONSENT_TTL_SECONDS=900
SYNTHETIC_CONTEXT_AUDIT_MAX_EVENTS=100
SYNTHETIC_CONTEXT_AUDIT_MAX_BYTES=65536
APPLICATIONINSIGHTS_CONNECTION_STRING=
API_METRICS_ENABLED=false

# Public Azure deployments inject these server-only settings from reviewed IaC.
REDIS_ENDPOINT=
REDIS_CLIENT_ID=
API_AUTH_TENANT_ID=
API_AUTH_AUDIENCE=
API_AUTH_CALLERS=[]
API_DAILY_RUN_LIMIT=0
API_DAILY_TOKEN_LIMIT=0
API_DAILY_COST_LIMIT_MICROUSD=0
API_TOKEN_PRICE_MICROUSD=0
# Web service only: API_AUTH_SCOPE, FRONT_DOOR_ID and CLIENT_HASH_KEY.
# Never put CLIENT_HASH_KEY in source control; IaC generates a Container App secret.

# Never commit credentials or expose them through NEXT_PUBLIC_* variables.
# API_BASE_URL and CONTENT_CATALOG_PATH are set by npm run dev.

# Optional per-answer research. Blank approvals and zero budgets keep both paths closed.
FOUNDRY_RESEARCH_AGENT=
FOUNDRY_IQ_ENABLED=false
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_KNOWLEDGE_SOURCE=
FOUNDRY_IQ_MODEL_DEPLOYMENT=
FOUNDRY_IQ_MODEL_NAME=
# Existing approved Search semantic configuration and planning-model endpoint.
AZURE_SEARCH_SEMANTIC_CONFIG=
AZURE_OPENAI_ENDPOINT=
FOUNDRY_IQ_PREVIEW_APPROVAL_ID=
FOUNDRY_IQ_CONTRACT_APPROVAL_ID=
FOUNDRY_IQ_BUDGET_APPROVAL_ID=
FOUNDRY_IQ_PER_RUN_COST_MICROUSD=0
FOUNDRY_IQ_DAILY_COST_LIMIT_MICROUSD=0
WEBIQ_RELEASE_APPROVAL_ID=
WEBIQ_APP_ID=
WEBIQ_PRIVACY_APPROVAL_ID=
WEBIQ_TERMS_APPROVAL_ID=
WEBIQ_EGRESS_APPROVED=false
WEBIQ_ZERO_QUERY_LOGGING_APPROVED=false
# Owner acceptance of default provider logging for fixed public-topic queries only.
WEBIQ_PUBLIC_QUERY_LOGGING_APPROVED=false
WEBIQ_TRANSIENT_HANDLING_VERIFIED=false
WEBIQ_SOURCE_APPROVAL_ID=
WEBIQ_SOURCES=[]
WEBIQ_BROWSE_SOURCE_IDENTITY_APPROVED=false
WEBIQ_PER_RUN_COST_MICROUSD=0
WEBIQ_DAILY_COST_LIMIT_MICROUSD=0
RESEARCH_DAILY_RUN_LIMIT=0
RESEARCH_MAX_CONCURRENT_RUNS=1
