APP_ENV=development
# CONTENT_CATALOG_PATH defaults to repository data/pilot-catalog.json, or /app/data.
CONTENT_CATALOG_PATH=
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,api

# Production requires seven versioned pathway bindings plus live verification.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENTS=[]
# Separate pinned prompt-agent bindings with no journey scope.
FOUNDRY_GENERAL_AGENT=
FOUNDRY_CONTEXTUAL_AGENT=
# The following two settings are a development-only compatibility path.
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_CLIENT_ID=
AZURE_SEARCH_SEMANTIC_CONFIG=
# Keep all three values on the v1 defaults until a reviewed atomic cutover:
# AZURE_SEARCH_INDEX=bc-pilot-public-v2
# AZURE_SEARCH_METADATA_ENABLED=true
# AZURE_SEARCH_METADATA_REVIEWED=1
AZURE_SEARCH_METADATA_ENABLED=false
AZURE_SEARCH_METADATA_REVIEWED=0

# Synthetic context is disabled unless the fixed fixtures, contextual binding,
# reviewed Search source scope and short-lived consent/session controls are ready.
SYNTHETIC_CONTEXT_ENABLED=false
SYNTHETIC_CONTEXT_SESSION_TTL_SECONDS=1800
SYNTHETIC_CONTEXT_CONSENT_TTL_SECONDS=900
SYNTHETIC_CONTEXT_AUDIT_MAX_EVENTS=100
SYNTHETIC_CONTEXT_AUDIT_MAX_BYTES=65536

# Shared public-preview controls. Zero allowances keep admission closed.
REDIS_ENDPOINT=
REDIS_CLIENT_ID=
API_CONTROL_NAMESPACE=bc-pilot
API_AUTH_TENANT_ID=
API_AUTH_AUDIENCE=
API_AUTH_CALLERS=[]
API_DAILY_RUN_LIMIT=0
API_DAILY_TOKEN_LIMIT=0
API_DAILY_COST_LIMIT_MICROUSD=0
API_TOKEN_PRICE_MICROUSD=0
API_METRICS_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional real-vector contract, aligned with ingestion. Disabled means lexical
# retrieval, optionally semantic; no vectors are fabricated or silently inferred.
AZURE_SEARCH_VECTOR_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Omit AZURE_OPENAI_EMBEDDING_DIMENSIONS until an approved deployment is selected.

WEBIQ_ENABLED=false
WEBIQ_APP_ID=
WEBIQ_PRIVACY_APPROVAL_ID=
WEBIQ_TERMS_APPROVAL_ID=
WEBIQ_EGRESS_APPROVED=false
WEBIQ_ZERO_QUERY_LOGGING_APPROVED=false
WEBIQ_TRANSIENT_HANDLING_VERIFIED=false
# There is no transport enable switch. Even satisfying every planning gate
# cannot enable Web IQ in this implementation.
