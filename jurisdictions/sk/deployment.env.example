# Local/closed Saskatchewan deployment template; not an approval to deploy.
# Never load BC's .env or reuse its identities, agent bindings, index or budgets.
JURISDICTION=sk
APP_ENV=development
WEB_PORT=3100
API_PORT=8100
AZURE_ENV_NAME=sk-staging
AZURE_DEPLOYMENT_STAGE=closed
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
