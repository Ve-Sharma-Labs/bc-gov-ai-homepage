{
  "schemaVersion": 1,
  "suiteId": "citizen-context-independent-evaluation-v1",
  "syntheticOnly": true,
  "remoteModelCallsAllowed": false,
  "measurementBoundary": "Measures deterministic questions, context use and server-owned artifacts. It does not score model answer quality or claim production eligibility accuracy.",
  "artifactOrder": [
    "context-summary",
    "program-matches",
    "application-preview",
    "consent-request",
    "audit-receipt"
  ],
